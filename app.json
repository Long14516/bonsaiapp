{
  "expo": {
    "name": "Long",
    "slug": "Long",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "scheme": "long",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.long"
    },

    "android": {
      "package": "com.long",

      "softwareKeyboardLayoutMode": "pan",

      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "long"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png"
        }
      ]
    ]
  }
}